async function registrarItemCarrinho() {
    if (!vendaIniciada) iniciarVenda();
    const inp =3D document.getElementById("input-scanner");
    let codigo =3D inp.value.trim();
    if (!codigo) return;

    let tipoBusca =3D "ean";
    if (codigo.startsWith(".")) {
        tipoBusca =3D "codigo_interno";
        codigo =3D codigo.substring(1).trim();
