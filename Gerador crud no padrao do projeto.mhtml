on)):
    try:
        session.exec(text(&quot;DELETE FROM auditoria_produtos_falhas;&quot=
;))
        produtos =3D session.exec(select(Produto)).all()

        for p in produtos:
            if Decimal(str(p.vuncom or &quot;0&quot;)) &lt;=3D Decimal(&quo=
t;0.00&quot;):
                session.add(AuditoriaProdutosFalhas(
                    id_produto=3Dp.cprod,
                    falha=3Df&quot;PRECO ZERADO: Produto {p.xprod} ativo se=
m valor comercial.&quot;
                ))
            elif not p.ibscbs_cst:
                session.add(AuditoriaProdutosFalhas(
                    id_produto=3Dp.cprod,
                    falha=3Df&quot;IVA DUAL INCOMPLETO: NCM {p.ncm} sem CST=
 IBS/CBS.&quot;
                ))
        session.commit()

        falhas =3D session.exec(select(AuditoriaProdutosFalhas)).all()
        return {&quot;inconsistencias&quot;: falhas}
    except Exception as e:
        session.rollback()
        raise HTTPException(status_code=3D500, detail=3Dstr(e))" role=3D"bu=
