<div jsuid=3D"IItvre_7y" class=3D"vqxIde" aria-label=3D"Mais op=C3=A7=C3=B5=
es para a resposta: N=C3=B3s j=C3=A1 criamos o nosso gerar xml da nota, mas=
 segue abaixo:@app.post(&quot;/api/v1/caixa/gerar-xml-nota&quot;)
def api_gerar_xml_nota_completa(dados: NotaInput, session: Session =3D Depe=
nds(get_session)):
    diretorio_script =3D os.path.dirname(os.path.abspath(__file__))
    pasta_destino =3D os.path.join(diretorio_script, &quot;xml_notas&quot;)
   =20
    # 1. Busca os dados da Loja utilizando o ORM do SQLModel
    loja_ativa =3D session.exec(
        select(Loja).where(Loja.id_loja =3D=3D dados.id_loja)
    ).first()
   =20
    if not loja_ativa:
        raise HTTPException(status_code=3D404, detail=3D&quot;Loja ativa n=
=C3=A3o encontrada.&quot;)

    # 2. Inicializa=C3=A7=C3=A3o do elemento raiz XML da NF-e
    nfe_root =3D ET.Element(&quot;NFe&quot;, xmlns=3D&quot;http://portalfis=
cal.inf.br&quot;)
   =20
    # Higieniza=C3=A7=C3=A3o e formata=C3=A7=C3=A3o do CNPJ do Emitente
    cnpj_limpo =3D &quot;&quot;.join(filter(str.isdigit, str(loja_ativa.cnp=
j_cpf))).zfill(14)
   =20
    # Gera=C3=A7=C3=A3o da Chave de Acesso (Mock estruturado mantendo a reg=
ra dos fontes originais)
    chave_acesso_mock =3D f&quot;NFe312610{cnpj_limpo}55001{str(dados.numer=
o_nota).zfill(9)}100000001&quot;
    inf_nfe =3D ET.SubElement(nfe_root, &quot;infNFe&quot;, Id=3Dchave_aces=
so_mock, versao=3D&quot;5.00&quot;)
   =20
    # 3. Grupo: ide (Identifica=C3=A7=C3=A3o da NF-e)
    ide =3D ET.SubElement(inf_nfe, &quot;ide&quot;)
    ET.SubElement(ide, &quot;cUF&quot;).text =3D &quot;31&quot;
    ET.SubElement(ide, &quot;natOp&quot;).text =3D &quot;Venda de Mercadori=
a&quot;
    ET.SubElement(ide, &quot;mod&quot;).text =3D &quot;55&quot;
    ET.SubElement(ide, &quot;serie&quot;).text =3D &quot;1&quot;
    ET.SubElement(ide, &quot;nNF&quot;).text =3D str(dados.numero_nota)
    ET.SubElement(ide, &quot;dhEmi&quot;).text =3D &quot;2026-10-27T19:30:0=
0-03:00&quot; # Data fixada conforme regras fiscais vigentes
    ET.SubElement(ide, &quot;tpNF&quot;).text =3D &quot;1&quot;
    ET.SubElement(ide, &quot;idDest&quot;).text =3D &quot;1&quot;
    ET.SubElement(ide, &quot;cMunFG&quot;).text =3D str(loja_ativa.codigo_m=
unicipio or &quot;3106200&quot;)
    ET.SubElement(ide, &quot;tpImp&quot;).text =3D &quot;1&quot;
    ET.SubElement(ide, &quot;tpEmis&quot;).text =3D &quot;1&quot;
    ET.SubElement(ide, &quot;tpAmb&quot;).text =3D &quot;2&quot;
    ET.SubElement(ide, &quot;finNFe&quot;).text =3D &quot;1&quot;
    ET.SubElement(ide, &quot;indPres&quot;).text =3D str(dados.indPres)
   =20
    # 4. Grupo: emit (Emitente da Nota)
    emit =3D ET.SubElement(inf_nfe, &quot;emit&quot;)
    ET.SubElement(emit, &quot;CNPJ&quot;).text =3D cnpj_limpo
    ET.SubElement(emit, &quot;xNome&quot;).text =3D str(loja_ativa.nome_raz=
ao)
   =20
    # 5. Acumuladores Globais de Totais (Tratamento estrito com Decimal)
    v_prod_total =3D Decimal(&quot;0.00&quot;)
    v_ibs_uf_total =3D Decimal(&quot;0.00&quot;)
    v_ibs_mun_total =3D Decimal(&quot;0.00&quot;)
    v_cbs_total =3D Decimal(&quot;0.00&quot;)
   =20
    # 6. Processamento dos itens informados no payload
    for idx, item in enumerate(dados.produtos, start=3D1):
        # Busca o produto de forma relacional at=C3=B4mica
        prod =3D session.exec(
            select(Produtos).where(Produtos.id_produto =3D=3D item.id_produ=
to)
        ).first()
       =20
        if not prod:
            continue

        v_item =3D item.valor_venda
        v_prod_total +=3D v_item
        ind_mono =3D prod.ind_monofasico
       =20
        # Al=C3=ADquotas baseadas nas flags fiscais injetadas
        p_ibs_uf =3D Decimal(&quot;14.50&quot;) if ind_mono !=3D 1 else Dec=
imal(&quot;0.00&quot;)
        p_ibs_mun =3D Decimal(&quot;3.20&quot;) if ind_mono !=3D 1 else Dec=
imal(&quot;0.00&quot;)
        p_cbs =3D Decimal(&quot;8.80&quot;) if ind_mono !=3D 1 else Decimal=
(&quot;0.00&quot;)
       =20
        # C=C3=A1lculos de partilha com precis=C3=A3o centesimal (.quantize=
)
        v_ibs_uf =3D (v_item * (p_ibs_uf / Decimal(&quot;100.00&quot;))).qu=
antize(Decimal(&quot;1.00&quot;))
        v_ibs_mun =3D (v_item * (p_ibs_mun / Decimal(&quot;100.00&quot;))).=
quantize(Decimal(&quot;1.00&quot;))
        v_cbs =3D (v_item * (p_cbs / Decimal(&quot;100.00&quot;))).quantize=
(Decimal(&quot;1.00&quot;))
       =20
        v_ibs_uf_total +=3D v_ibs_uf
        v_ibs_mun_total +=3D v_ibs_mun
        v_cbs_total +=3D v_cbs
       =20
        # Inje=C3=A7=C3=A3o das Tags de Detalhamento do Produto no XML
        det =3D ET.SubElement(inf_nfe, &quot;det&quot;, nItem=3Dstr(idx))
        prod_tag =3D ET.SubElement(det, &quot;prod&quot;)
        ET.SubElement(prod_tag, &quot;cProd&quot;).text =3D str(item.id_pro=
duto)
        ET.SubElement(prod_tag, &quot;xProd&quot;).text =3D str(prod.nome_p=
roduto)
        ET.SubElement(prod_tag, &quot;NCM&quot;).text =3D str(prod.ncm)
        ET.SubElement(prod_tag, &quot;uCom&quot;).text =3D &quot;UN&quot;
        ET.SubElement(prod_tag, &quot;qCom&quot;).text =3D &quot;1.000&quot=
;
        ET.SubElement(prod_tag, &quot;vUnCom&quot;).text =3D f&quot;{v_item=
:.2f}&quot;
        ET.SubElement(prod_tag, &quot;vProd&quot;).text =3D f&quot;{v_item:=
.2f}&quot;
       =20
        # Bloco da Reforma Tribut=C3=A1ria (IVA Dual) por Item
        imposto =3D ET.SubElement(det, &quot;imposto&quot;)
        ub_block =3D ET.SubElement(imposto, &quot;UB&quot;)
        ET.SubElement(ub_block, &quot;cst&quot;).text =3D str(prod.cst_iva_=
dual or &quot;000&quot;).zfill(3)
        ET.SubElement(ub_block, &quot;cClassTrib&quot;).text =3D str(prod.c=
class_trib or &quot;000001&quot;).zfill(6)
        ET.SubElement(ub_block, &quot;vBC&quot;).text =3D f&quot;{v_item:.2=
f}&quot;
        ET.SubElement(ub_block, &quot;vIBSUF&quot;).text =3D f&quot;{v_ibs_=
uf:.2f}&quot;
        ET.SubElement(ub_block, &quot;vIBSMun&quot;).text =3D f&quot;{v_ibs=
_mun:.2f}&quot;
        ET.SubElement(ub_block, &quot;vCBS&quot;).text =3D f&quot;{v_cbs:.2=
f}&quot;
       =20
    # 7. Consolida=C3=A7=C3=A3o de Valores Totais da Nota
    v_ibs_total_consolidado =3D v_ibs_uf_total + v_ibs_mun_total
    v_nf_total =3D v_prod_total + v_ibs_total_consolidado + v_cbs_total
   =20
    total =3D ET.SubElement(inf_nfe, &quot;total&quot;)
    w_block =3D ET.SubElement(total, &quot;IBSCBS&quot;)
    ET.SubElement(w_block, &quot;vBCIBSCBS&quot;).text =3D f&quot;{v_prod_t=
otal:.2f}&quot;
    ET.SubElement(w_block, &quot;vIBS&quot;).text =3D f&quot;{v_ibs_total_c=
onsolidado:.2f}&quot;
    ET.SubElement(w_block, &quot;vCBS&quot;).text =3D f&quot;{v_cbs_total:.=
2f}&quot;
    ET.SubElement(w_block, &quot;vNFTot&quot;).text =3D f&quot;{v_nf_total:=
.2f}&quot;
   =20
    # 8. Formata=C3=A7=C3=A3o (Pretty Print) e Escrita em Disco
    rough_string =3D ET.tostring(nfe_root, 'utf-8')
    reparsed =3D minidom.parseString(rough_string)
    xml_formatado =3D reparsed.toprettyxml(indent=3D&quot;    &quot;)
   =20
    # Remove a declara=C3=A7=C3=A3o xml autom=C3=A1tica para compatibilidad=
e SEFAZ
    linhas =3D xml_formatado.split(&quot;\n&quot;)
    if linhas[0].startswith(&quot;&lt;?xml&quot;):
        linhas =3D linhas[1:]
    xml_final =3D &quot;\n&quot;.join(linhas)
       =20
    if not os.path.exists(pasta_destino):
        os.makedirs(pasta_destino, exist_ok=3DTrue)
       =20
    caminho_arquivo =3D os.path.join(pasta_destino, f&quot;nota_{dados.nume=
ro_nota}.xml&quot;)
