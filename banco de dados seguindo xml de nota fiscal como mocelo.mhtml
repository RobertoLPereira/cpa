=20
 # 1. Busca os dados da Loja utilizando o ORM do SQLModel
 loja_ativa =3D session.exec(
 select(Loja).where(Loja.id_loja =3D=3D dados.id_loja)
 ).first()
=20
 if not loja_ativa:
 raise HTTPException(status_code=3D404, detail=3D"Loja ativa n=C3=A3o encon=
trada.")

 # 2. Inicializa=C3=A7=C3=A3o do elemento raiz XML da NF-e
 nfe_root =3D ET.Element("NFe", xmlns=3D"http://portalfiscal.inf.br")
=20
 # Higieniza=C3=A7=C3=A3o e formata=C3=A7=C3=A3o do CNPJ do Emitente
 cnpj_limpo =3D "".join(filter(str.isdigit, str(loja_ativa.cnpj_cpf))).zfil=
l(14)
=20
 # Gera=C3=A7=C3=A3o da Chave de Acesso (Mock estruturado mantendo a regra =
dos fontes originais)
 chave_acesso_mock =3D f"NFe312610{cnpj_limpo}55001{str(dados.numero_nota).=
zfill(9)}100000001"
 inf_nfe =3D ET.SubElement(nfe_root, "infNFe", Id=3Dchave_acesso_mock, vers=
ao=3D"5.00")
=20
 # 3. Grupo: ide (Identifica=C3=A7=C3=A3o da NF-e)
 ide =3D ET.SubElement(inf_nfe, "ide")
