 ET.SubElement(prod_tag, "xProd").text =3D str(prod.nome_produto)
 ET.SubElement(prod_tag, "NCM").text =3D str(prod.ncm)
 ET.SubElement(prod_tag, "uCom").text =3D "UN"
 ET.SubElement(prod_tag, "qCom").text =3D "1.000"
 ET.SubElement(prod_tag, "vUnCom").text =3D f"{v_item:.2f}"
 ET.SubElement(prod_tag, "vProd").text =3D f"{v_item:.2f}"
=20
 # Bloco da Reforma Tribut=C3=A1ria (IVA Dual) por Item
 imposto =3D ET.SubElement(det, "imposto")
 ub_block =3D ET.SubElement(imposto, "UB")
 ET.SubElement(ub_block, "cst").text =3D str(prod.cst_iva_dual or "000").zf=
ill(3)
 ET.SubElement(ub_block, "cClassTrib").text =3D str(prod.cclass_trib or "00=
0001").zfill(6)
 ET.SubElement(ub_block, "vBC").text =3D f"{v_item:.2f}"
 ET.SubElement(ub_block, "vIBSUF").text =3D f"{v_ibs_uf:.2f}"
 ET.SubElement(ub_block, "vIBSMun").text =3D f"{v_ibs_mun:.2f}"
 ET.SubElement(ub_block, "vCBS").text =3D f"{v_cbs:.2f}"
=20
 # 7. Consolida=C3=A7=C3=A3o de Valores Totais da Nota
 v_ibs_total_consolidado =3D v_ibs_uf_total + v_ibs_mun_total
 v_nf_total =3D v_prod_total + v_ibs_total_consolidado + v_cbs_total
=20
 total =3D ET.SubElement(inf_nfe, "total")
 w_block =3D ET.SubElement(total, "IBSCBS")
 ET.SubElement(w_block, "vBCIBSCBS").text =3D f"{v_prod_total:.2f}"
 ET.SubElement(w_block, "vIBS").text =3D f"{v_ibs_total_consolidado:.2f}"
 ET.SubElement(w_block, "vCBS").text =3D f"{v_cbs_total:.2f}"
 ET.SubElement(w_block, "vNFTot").text =3D f"{v_nf_total:.2f}"
=20
 # 8. Formata=C3=A7=C3=A3o (Pretty Print) e Escrita em Disco
 rough_string =3D ET.tostring(nfe_root, 'utf-8')
 reparsed =3D minidom.parseString(rough_string)
 xml_formatado =3D reparsed.toprettyxml(indent=3D" ")
=20
 # Remove a declara=C3=A7=C3=A3o xml autom=C3=A1tica para compatibilidade S=
EFAZ
 linhas =3D xml_formatado.split("\n")
 if linhas[0].startswith("&lt;?xml"):
 linhas =3D linhas[1:]
 xml_final =3D "\n".join(linhas)
=20
 if not os.path.exists(pasta_destino):
 os.makedirs(pasta_destino, exist_ok=3DTrue)
=20
 caminho_arquivo =3D os.path.join(pasta_destino, f"nota_{dados.numero_nota}=
.xml")
 with open(caminho_arquivo, "w", encoding=3D"utf-8") as f:
 f.write(xml_final)
=20
 return Response(content=3Dxml_final, media_type=3D"application/xml")

