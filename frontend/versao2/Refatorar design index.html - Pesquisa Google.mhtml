a N=C3=A3o seria melhor aplicar o teste de pre=C3=A7o zerado aqui:def calcu=
lar_item_cupom(codigo_lido: str, aliq_base_ibs: float =3D 0.01, aliq_base_c=
bs: float =3D 0.09):
    """
    Realiza a busca at=C3=B4mica na tabela mestre de produtos e calcula a c=
arga
    tribut=C3=A1ria efetiva baseando-se unicamente nas flags e al=C3=ADquot=
as do banco.
    """
    eh_balanca, id_busca, valor_etiqueta =3D decompor_codigo_scanner(codigo=
_lido)
   =20
    conn =3D obter_conexao()
    cursor =3D conn.cursor()
   =20
    cursor.execute("""
        SELECT nome_produto, ncm, cst_iva_dual, cclass_trib, ind_monofasico=
, ibpt_fed, ibpt_est, preco_venda
        FROM produtos
        WHERE id_produto =3D ?;
    """, (id_busca,))
   =20
    produto =3D cursor.fetchone()
    conn.close()
    print(produto)
    # Valida=C3=A7=C3=A3o de Item n=C3=A3o localizado no cadastro mestre
    if not produto:
        return {
            "status": "REJEITADO",
            "motivo": f"C=C3=B3digo {id_busca} n=C3=A3o localizado na Tabel=
a Mestre de Produtos."
        }
       =20
    # Desempacota os dados da linha da tabela mestre
    nome =3D produto["nome_produto"]
    ncm =3D produto["ncm"]
    cst =3D produto["cst_iva_dual"] if produto["cst_iva_dual"] is not None =
else "000"
    cclass_trib =3D produto["cclass_trib"] if produto["cclass_trib"] is not=
 None else "000001"
    ind_mono =3D produto["ind_monofasico"] if produto["ind_monofasico"] is =
not None else 0
    ibpt_fed =3D produto["ibpt_fed"] if produto["ibpt_fed"] is not None els=
e 0.0
    ibpt_est =3D produto["ibpt_est"] if produto["ibpt_est"] is not None els=
e 0.0
    preco_venda_cadastro =3D float(produto["preco_venda"]) if produto["prec=
o_venda"] else 0.0

    # Alerta de Seguran=C3=A7a Tribut=C3=A1ria e Comercial: Bloqueia fatura=
mento com pre=C3=A7o zerado
    if preco_venda_cadastro =3D=3D 0.0 and valor_etiqueta is None:
        return {
            "status": "BLOQUEADO",
            "nome": nome,
            "motivo": f"Produto '{nome}' est=C3=A1 com PRE=C3=87O ZERADO no=
 cadastro mestre."
        }

    # Defini=C3=A7=C3=A3o matem=C3=A1tica do valor final e c=C3=A1lculo do =
peso reverso
    if eh_balanca:
        if valor_etiqueta is not None:
            valor_final_item =3D valor_etiqueta
            quantidade_peso =3D valor_final_item / preco_venda_cadastro if =
preco_venda_cadastro &gt; 0 else 0.0
        else:
            quantidade_peso =3D 1.000  # Fallback padr=C3=A3o para ID curto=
 digitado manual
            valor_final_item =3D preco_venda_cadastro * quantidade_peso
        unidade =3D "KG"
    else:
        valor_final_item =3D preco_venda_cadastro
        quantidade_peso =3D 1.0
        unidade =3D "UN"

    # Decis=C3=A3o Orientada a Dados Fiscal: Avalia a flag booleana de Mono=
f=C3=A1sico
    if ind_mono =3D=3D 1:
        aliq_efetiva_ibs =3D 0.0
        aliq_efetiva_cbs =3D 0.0
        regime_nome =3D "Monof=C3=A1sico (Sa=C3=ADda com 0%)"
    else:
        aliq_efetiva_ibs =3D aliq_base_ibs
        aliq_efetiva_cbs =3D aliq_base_cbs
        regime_nome =3D "Tributa=C3=A7=C3=A3o Regular Integral"

    # C=C3=A1lculos exatos de fra=C3=A7=C3=B5es
    v_ibs =3D valor_final_item * aliq_efetiva_ibs
    v_cbs =3D valor_final_item * aliq_efetiva_cbs
   =20
    # C=C3=A1lculos aproximados do IBPT real trazido pela planilha
    v_ibpt_fed =3D valor_final_item * (ibpt_fed / 100.0)
    v_ibpt_est =3D valor_final_item * (ibpt_est / 100.0)

    return {
        "status": "APROVADO",
        "id_produto": id_busca,
        "nome_produto": nome,
        "ncm": ncm,
        "uCom": unidade,
        "qCom": round(quantidade_peso, 3),
        "vUnCom": round(preco_venda_cadastro, 2),
        "vProd": round(valor_final_item, 2),
        "regime": regime_nome,
        "IBSCBS": {
            "CST": str(cst).zfill(3),
            "cClassTrib": str(cclass_trib).zfill(6),
            "vBC": round(valor_final_item, 2),
            "vIBS": round(v_ibs, 2),
            "pIBS": f"{(aliq_efetiva_ibs*100):.4f}",
            "vCBS": round(v_cbs, 2),
            "pCBS": f"{(aliq_efetiva_cbs*100):.4f}"
        },
        "ibpt": {
            "pFed": ibpt_fed,
            "pEst": ibpt_est,
            "vFed": round(v_ibpt_fed, 2),
            "vEst": round(v_ibpt_est, 2)
        }
    }<!--TgQPHdBthOwe_1/We76zc|||[{&quot;s&quot;:false,&quot;i&quot;:&quot;=
